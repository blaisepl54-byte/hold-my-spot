# .env.example, the B1 credential contract. PLACEHOLDERS ONLY.
#
# This file is tracked. `.gitignore` ignores `.env` and `.env.*` and re-admits
# `.env.example` only, so the real file can never be staged by accident.
# NO REAL VALUE MAY EVER BE WRITTEN HERE.
#
# Copy to `.env` and fill in. `.env` is never committed, never printed, never
# echoed, and never interpolated into any output including presence checks.
#
# THE THREE NAMES ARE NOT A PROPOSAL. They are already bound by shipped code,
# so `.env` must use exactly these spellings:
#
#   HMS_RO_URL   src/persistence/read/index.ts:14
#   HMS_RW_URL   src/persistence/write/index.ts:17
#   HMS_DDL_URL  db/migrate.ts:34
#
# Role model per HMS-KS-002 v4 R5, PRIMARY, pin
# sha256:9f99b1cca62dc2570c26a926239656cce707c3468d6ee009a8fe1383f1a10768
# ruled the role-model source by BUILD_ORDER_2.md revision 2, section B1.
#
#   hms_ddl  DDL only. Used by db/migrate.ts and nothing else.
#   hms_rw   SELECT, INSERT, UPDATE, DELETE. No DDL.
#   hms_ro   SELECT only.
#
# Per R-C, King B creates the roles and supplies one URL per role, each with its
# own limited password. The implementer never holds a superuser credential and
# does not seek one. If a role proves to need something not supplied, B1 stops
# and names it rather than obtaining it another way.
#
# Each URL carries a DIFFERENT password. Three URLs differing only in username
# would mean one credential wearing three names, and B1's property two, that
# each role is bounded, could not then be attributed to the role rather than to
# the connection.

HMS_DDL_URL=postgresql://hms_ddl:REPLACE_ME@localhost:5432/REPLACE_DBNAME
HMS_RW_URL=postgresql://hms_rw:REPLACE_ME@localhost:5432/REPLACE_DBNAME
HMS_RO_URL=postgresql://hms_ro:REPLACE_ME@localhost:5432/REPLACE_DBNAME
